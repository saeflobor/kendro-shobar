# Google Apps Script Web App URL for form submission and count retrieval.
# See GOOGLE_SHEETS_SETUP.md for setup instructions.
# Example: https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
GOOGLE_SHEETS_URL=

# Optional shared secret to protect writes to the Google Sheet.
# Must match the WRITE_KEY constant inside your Apps Script.
GOOGLE_SHEETS_WRITE_KEY=

# (Optional) External link for the "find your voting center" button.
NEXT_PUBLIC_VOTING_CENTER_URL=

# Note: If GOOGLE_SHEETS_URL is not set, the app will still work in
# development and save data to a local file (data/submissions.txt)
